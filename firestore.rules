rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Users collection - public profiles but private data
    match /users/{userId} {
      // Anyone can read public user info
      allow read: if isAuthenticated();

      // Users can write their own data
      allow write: if isOwner(userId);

      // Admin can read/write all
      allow read, write: if isAdmin();
    }

    // Daily Missions - private to user
    match /daily_missions/{docId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Spin History - private to user
    match /spin_history/{docId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Trivia Results - private to user
    match /trivia_results/{docId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // User Spins - private to user
    match /user_spins/{userId} {
      allow read, write: if isOwner(userId);
      allow read, write: if isAdmin();
    }

    // Video Ads Watched - private to user
    match /video_ads_watched/{docId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Instagram Follows - private to user
    match /instagram_follows/{docId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Referrals - private to referrer
    match /referrals/{docId} {
      allow create: if isAuthenticated() && request.resource.data.referrerId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.referrerId == request.auth.uid || resource.data.refereeId == request.auth.uid);
      allow write: if isAuthenticated() && resource.data.referrerId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Leaderboard data - public (users can see rankings)
    match /leaderboard_stats/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Catch-all - deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
